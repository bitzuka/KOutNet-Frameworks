koutnet.pw, www.koutnet.pw {
        @synapse path /_matrix/* /_synapse/client/*
        handle @synapse {
                reverse_proxy localhost:8008
        }

        handle /.well-known/matrix/server {
                header Content-Type application/json
                respond `{"m.server": "koutnet.pw:443"}` 200
        }

        handle /.well-known/matrix/client {
                header Content-Type application/json
                header Access-Control-Allow-Origin *
                respond `{"m.homeserver": {"base_url": "https://koutnet.pw"}}` 200
        }

        handle_path /assets/* {
                root * /var/www/koutnet-assets
                file_server
        }

        handle /api/auth/register {
                reverse_proxy 127.0.0.1:3100 {
                        header_up -Cookie
                }
        }

        handle_path /code/* {
                root * /var/www/koutnet/code
                @codefile path_regexp codefile /[^/]+$
                header @codefile Content-Type "text/plain; charset=utf-8"
                header Cache-Control "no-store"
                file_server browse
        }

        handle {
                root * /var/www/koutnet
                @html path / /index.html /404.html /registration.html /koutnet-registration.html /download.html
                header @html Cache-Control "no-store"
                file_server
        }

        handle_errors {
                rewrite * /404.html
                file_server
        }
}

tasks.koutnet.pw {
        encode gzip

        handle /api/* {
                reverse_proxy 127.0.0.1:3100 {
                        header_up -Cookie
                }
        }

        handle /data/* {
                header Cache-Control "no-store"
                root * /var/www/koutnet-tasks
                file_server
        }

        handle_path /assets/* {
                root * /var/www/koutnet-assets
                file_server
        }

        handle /sp-login.html {
                header Cache-Control "no-store"
                root * /var/www/koutnet-tasks
                file_server
        }

        handle {
                root * /var/www/koutnet-tasks
                header Cache-Control "no-store"
                try_files {path} /index.html
                file_server
        }
}

# SP: щитпосты, общий аккаунт с Tasks.
sp.koutnet.pw {
        encode gzip

        handle /api/* {
                reverse_proxy 127.0.0.1:3101 {
                        header_up -Cookie
                }
        }

        handle {
                root * /opt/koutnet-sp/public
                try_files {path} /index.html
                header Cache-Control "no-store"
                file_server
        }
}
